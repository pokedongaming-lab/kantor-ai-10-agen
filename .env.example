# PANDUAN KONEKSI AUTO-PUBLISH MEDIA SOSIAL (ANDRE D'ANDREAS)

# 1. METODE WEBHOOK (DIREKOMENDASIKAN - via n8n / Make.com / Zapier)
# Hubungkan akun Instagram, TikTok, dan YouTube Shorts kamu ke n8n/Make,
# lalu salin Webhook URL yang dihasilkan ke bawah ini:
PUBLISH_WEBHOOK_URL=https://primary-production-xxxx.up.railway.app/webhook/publish-social

# 2. METODE DIRECT API (Opsional)
# META GRAPH API (Instagram Professional):
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_ACCESS_TOKEN=your_meta_graph_api_access_token

# TIKTOK CONTENT POSTING API:
TIKTOK_ACCESS_TOKEN=your_tiktok_creator_access_token

# YOUTUBE DATA API v3 (Shorts):
YOUTUBE_CLIENT_ID=your_google_client_id
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
