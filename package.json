    "tokens": "node scripts/token-monitor.mjs",
    "rekam": "node scripts/rekam.mjs",
    "publish": "node scripts/auto-publish.mjs",
    "publish:dry": "node scripts/auto-publish.mjs --dry-run",
    "agents:run": "node scripts/run-autonomous-agents.mjs",
    "server": "node scripts/api-server.mjs",
    "telegram": "node scripts/telegram-bot-service.mjs",
    "video:remotion": "node scripts/render-remotion.mjs",
    "video:studio": "cd indostill-video && npm run dev"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^6.1.1",
